@@ -0,0 +1,108 @@
+package usage
+
+import (
+	"bytes"
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+)
+
+func TestTelemetryUsagePluginHandleUsage(t *testing.T) {
+	var buf bytes.Buffer
+	originalOutput := log.StandardLogger().Out
+	originalLevel := log.StandardLogger().Level
+	log.SetOutput(&buf)
+	log.SetLevel(log.InfoLevel)
+	defer func() {
+		log.SetOutput(originalOutput)
+		log.SetLevel(originalLevel)
+	}()
+
+	plugin := &telemetryUsagePlugin{}
+	reqTime := time.Date(2026, 11, 10, 18, 0, 0, 0, time.UTC)
+	record := Record{
+		RequestedAt: reqTime,
+		Model:       "claude-3-7-sonnet",
+		Provider:    "anthravity",
+		AuthID:      "test-account-1",
+		Stream:      true,
+		Failed:      false,
+		Detail: Detail{
+			InputTokens:  150,
+			OutputTokens: 320,
+		},
+	}
+
+	plugin.HandleUsage(context.Background(), record)
+
+	out := buf.String()
+	expectedSubstrings := []string{
+		"[usage]",
+		"timestamp=2026-11-10T18:00:00Z",
+		"model=claude-3-7-sonnet",
+		"provider=anthravity",
+		"auth=test-account-1",
+		"input=150",
+		"output=320",
+		"mode=stream",
+		"status=200",
+	}
+	for _, expected := range expectedSubstrings {
+		if !strings.Contains(out, expected) {
+			t.Errorf("expected output to contain %q, got: %s", expected, out)
+		}
+	}
+}
+
+func TestTelemetryUsagePluginHandleUsageFailure(t *testing.T) {
+	var buf bytes.Buffer
+	originalOutput := log.StandardLogger().Out
+	originalLevel := log.StandardLogger().Level
+	log.SetOutput(&buf)
+	log.SetLevel(log.InfoLevel)
+	defer func() {
+		log.SetOutput(originalOutput)
+		log.SetLevel(originalLevel)
+	}()
+
+	plugin := &telemetryUsagePlugin{}
+	reqTime := time.Date(2026, 11, 10, 18, 0, 0, 0, time.UTC)
+	record := Record{
+		RequestedAt: reqTime,
+		Model:       "gpt-4o",
+		Provider:    "openai",
+		AuthIndex:   "auth-index-2",
+		Stream:      false,
+		Failed:      true,
+		Fail: Failure{
+			StatusCode: 429,
+		},
+		Detail: Detail{
+			InputTokens:  42,
+			OutputTokens: 0,
+		},
+	}
+
+	plugin.HandleUsage(context.Background(), record)
+
+	out := buf.String()
+	expectedSubstrings := []string{
+		"[usage]",
+		"timestamp=2026-11-10T18:00:00Z",
+		"model=gpt-4o",
+		"provider=openai",
+		"auth=auth-index-2",
+		"input=42",
+		"output=0",
+		"mode=chat",
+		"status=429",
+	}
+	for _, expected := range expectedSubstrings {
+		if !strings.Contains(out, expected) {
+			t.Errorf("expected output to contain %q, got: %s", expected, out)
+		}
+	}
+}

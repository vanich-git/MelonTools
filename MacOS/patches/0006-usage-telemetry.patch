+package usage
+
+import (
+	"context"
+	"strings"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+)
+
+func init() {
+	RegisterPlugin(&telemetryUsagePlugin{})
+}
+
+type telemetryUsagePlugin struct{}
+
+func (p *telemetryUsagePlugin) HandleUsage(_ context.Context, record Record) {
+	if p == nil {
+		return
+	}
+
+	timestamp := record.RequestedAt
+	if timestamp.IsZero() {
+		timestamp = time.Now()
+	}
+	tsStr := timestamp.UTC().Format(time.RFC3339)
+
+	model := strings.TrimSpace(record.Model)
+	if model == "" {
+		model = strings.TrimSpace(record.ResponseModel)
+	}
+	if model == "" {
+		model = "unknown"
+	}
+	model = sanitizeTelemetryToken(model)
+
+	provider := strings.TrimSpace(record.Provider)
+	if provider == "" {
+		provider = "unknown"
+	}
+	provider = sanitizeTelemetryToken(provider)
+
+	auth := strings.TrimSpace(record.AuthID)
+	if auth == "" {
+		auth = strings.TrimSpace(record.AuthIndex)
+	}
+	if auth == "" {
+		auth = "none"
+	}
+	auth = sanitizeTelemetryToken(auth)
+
+	inputTokens := record.Detail.InputTokens
+	outputTokens := record.Detail.OutputTokens
+
+	mode := "chat"
+	if record.Stream {
+		mode = "stream"
+	}
+
+	statusCode := 200
+	if record.Failed {
+		if record.Fail.StatusCode > 0 {
+			statusCode = record.Fail.StatusCode
+		} else {
+			statusCode = 500
+		}
+	}
+
+	log.Infof("[usage] timestamp=%s model=%s provider=%s auth=%s input=%d output=%d mode=%s status=%d",
+		tsStr, model, provider, auth, inputTokens, outputTokens, mode, statusCode)
+}
+
+func sanitizeTelemetryToken(s string) string {
+	s = strings.ReplaceAll(s, " ", "_")
+	s = strings.ReplaceAll(s, "\"", "")
+	s = strings.ReplaceAll(s, "\n", "")
+	s = strings.ReplaceAll(s, "\r", "")
+	return s
+}

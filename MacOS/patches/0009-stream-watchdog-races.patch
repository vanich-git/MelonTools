diff --git a/sdk/cliproxy/auth/stream_bootstrap_guards.go b/sdk/cliproxy/auth/stream_bootstrap_guards.go
new file mode 100644
index 0000000..25c627d
--- /dev/null
+++ b/sdk/cliproxy/auth/stream_bootstrap_guards.go
@@ -0,0 +1,71 @@
+package auth
+
+import (
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// bootstrapHeartbeatExtension is how long an empty frame extends the first-token
+// timer: the full timeout, or the remaining grace when that is shorter. The cap
+// has to clamp the extension, otherwise a heartbeat arriving just before the cap
+// buys another whole timeout and a stuck upstream is held past the grace.
+func bootstrapHeartbeatExtension(timeout time.Duration, cap time.Time, now time.Time) time.Duration {
+	remaining := cap.Sub(now)
+	if remaining <= 0 {
+		return 0
+	}
+	if remaining < timeout {
+		return remaining
+	}
+	return timeout
+}
+
+// streamBootstrapHasFirstPayload reports whether the bootstrap read produced a
+// real first token. A stream that closes after only empty heartbeat frames has
+// no payload, so it must not count as a first token nor reset the strikes.
+func streamBootstrapHasFirstPayload(buffered []cliproxyexecutor.StreamChunk) bool {
+	for _, chunk := range buffered {
+		if len(chunk.Payload) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// headerWatchdog bounds the wait for upstream response headers. The timer
+// callback runs on its own goroutine, so its bookkeeping is published through
+// the done channel: a false result from timer.Stop means the callback has
+// started or finished, and fired waits for it before deciding. Reading a flag
+// without that wait could observe the cancellation before the flag was stored
+// and report a timed-out request as a success.
+type headerWatchdog struct {
+	timer *time.Timer
+	done  chan struct{}
+}
+
+func startHeaderWatchdog(timeout time.Duration, onFire func()) *headerWatchdog {
+	watchdog := &headerWatchdog{done: make(chan struct{})}
+	watchdog.timer = time.AfterFunc(timeout, func() {
+		defer close(watchdog.done)
+		if onFire != nil {
+			onFire()
+		}
+	})
+	return watchdog
+}
+
+// fired stops the watchdog and reports whether it fired before the caller
+// reached this point. Stop prevents a callback that has not started yet, so the
+// answer is exact; when the callback already started the call waits for it to
+// finish instead of racing with it.
+func (w *headerWatchdog) fired() bool {
+	if w == nil {
+		return false
+	}
+	if w.timer.Stop() {
+		return false
+	}
+	<-w.done
+	return true
+}
diff --git a/sdk/cliproxy/auth/stream_bootstrap_guards_test.go b/sdk/cliproxy/auth/stream_bootstrap_guards_test.go
new file mode 100644
index 0000000..0e9bdb8
--- /dev/null
+++ b/sdk/cliproxy/auth/stream_bootstrap_guards_test.go
@@ -0,0 +1,87 @@
+package auth
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func TestBootstrapHeartbeatExtensionClampsToCap(t *testing.T) {
+	timeout := 10 * time.Second
+	now := time.Unix(1_000_000, 0)
+	cap := now.Add(bootstrapHeartbeatGrace(timeout))
+
+	cases := []struct {
+		name string
+		at   time.Time
+		want time.Duration
+	}{
+		{"start", now, timeout},
+		{"inside grace", cap.Add(-5 * time.Second), 5 * time.Second},
+		{"at cap", cap, 0},
+		{"past cap", cap.Add(time.Second), 0},
+	}
+	for _, tc := range cases {
+		if got := bootstrapHeartbeatExtension(timeout, cap, tc.at); got != tc.want {
+			t.Fatalf("%s: extension = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestStreamBootstrapHasFirstPayload(t *testing.T) {
+	if streamBootstrapHasFirstPayload(nil) {
+		t.Fatal("nil buffered chunks must not count as a first token")
+	}
+	heartbeats := []cliproxyexecutor.StreamChunk{{Payload: nil}, {Payload: []byte{}}}
+	if streamBootstrapHasFirstPayload(heartbeats) {
+		t.Fatal("empty heartbeat frames must not count as a first token")
+	}
+	withPayload := append(append([]cliproxyexecutor.StreamChunk{}, heartbeats...), cliproxyexecutor.StreamChunk{Payload: []byte("data")})
+	if !streamBootstrapHasFirstPayload(withPayload) {
+		t.Fatal("a real payload must count as a first token")
+	}
+}
+
+func TestHeaderWatchdogNotFiredStopsTimer(t *testing.T) {
+	watchdog := startHeaderWatchdog(time.Hour, func() {
+		t.Error("watchdog fired before its deadline")
+	})
+	if watchdog.fired() {
+		t.Fatal("fired() = true, want false before the deadline")
+	}
+}
+
+func TestHeaderWatchdogFiredWaitsForCallback(t *testing.T) {
+	callbackDone := make(chan struct{})
+	watchdog := startHeaderWatchdog(0, func() {
+		close(callbackDone)
+	})
+	<-callbackDone
+	if !watchdog.fired() {
+		t.Fatal("fired() = false, want true after the callback ran")
+	}
+}
+
+func TestReadStreamBootstrapEmptyClosedStreamKeepsStrikes(t *testing.T) {
+	SetStreamBootstrapTimeout(1)
+	t.Cleanup(func() { SetStreamBootstrapTimeout(0) })
+
+	const authID, model = "auth-empty", "model-empty"
+	resetBootstrapStrikes(authID, model)
+	nextBootstrapCooldown(authID, model, time.Now())
+	nextBootstrapCooldown(authID, model, time.Now())
+
+	ch := make(chan cliproxyexecutor.StreamChunk)
+	close(ch)
+	buffered, closed, err := readStreamBootstrapForAuth(context.Background(), ch, authID, model, "antigravity", time.Now())
+	if err != nil || !closed || len(buffered) != 0 {
+		t.Fatalf("buffered=%d closed=%v err=%v, want an empty closed stream", len(buffered), closed, err)
+	}
+	// The stream carried no token: the silent failures that already put this
+	// auth/model pair on the ladder must survive.
+	if got := bootstrapStrikeCount(authID, model); got != 2 {
+		t.Fatalf("strike count = %d, want the previous 2 strikes to survive", got)
+	}
+}

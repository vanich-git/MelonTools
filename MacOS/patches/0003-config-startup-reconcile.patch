@@ -171,6 +171,11 @@ func (w *Watcher) SetConfig(cfg *config.Config) {
 	w.clientsMutex.Lock()
 	defer w.clientsMutex.Unlock()
 	w.config = cloned
+	if cloned != nil && cloned.SourceHash != "" {
+		// The config was parsed from these exact bytes. Remember them so the
+		// watcher can tell whether the file changed while it was starting up.
+		w.lastConfigHash = cloned.SourceHash

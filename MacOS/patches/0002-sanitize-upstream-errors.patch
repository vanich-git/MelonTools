+// sanitizeUpstreamError keeps internal endpoints out of client-visible
+// errors. A failed local runtime used to surface as
+// `Post "http://127.0.0.1:18318/v1/chat/completions": dial tcp ...`, which
+// leaks the internal port and tells the user nothing actionable.
+func sanitizeUpstreamError(err error) string {
+	if err == nil {
+		return ""
+	}
+	msg := err.Error()
+	lower := strings.ToLower(msg)
+	if strings.Contains(lower, "127.0.0.1") || strings.Contains(lower, "localhost") ||
+		strings.Contains(lower, "[::1]") {
+		return "Local AI runtime is not running. Start the model in Melon Tools and retry."
+	}
+	if strings.Contains(lower, "connection refused") ||
+		strings.Contains(lower, "no such host") ||
+		strings.Contains(lower, "i/o timeout") {
+		return "Upstream provider is unavailable."
+	}
+	return msg
+}
+

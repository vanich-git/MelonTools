@@ -2905,3 +2941,75 @@ func nextQuotaCooldown(prevLevel int, disableCooling bool) (time.Duration, int)
 	}
 	return cooldown, prevLevel + 1
 }
+
+// antigravityTOSViolationMarkers identify an account-level Terms of Service
+// block. Google answers these with 403 and reason TOS_VIOLATION, and no retry,
+// cooldown or routing change can make the call succeed again: only an appeal
+// filed by the account owner can. Treating it as a transient 403 is what turns a
+// permanent ban into a recurring retry loop against a dead credential.
+var antigravityTOSViolationMarkers = [...]string{
+	"tos_violation",
+	"violation of terms of service",
+	"violation of the terms of service",
+	"has been disabled in this account",
+}
+
+// antigravityValidationMarkers identify a challenge Google raises while it
+// re-verifies the account. Unlike a TOS block this one clears on its own, so it
+// gets a short cooldown instead of either a 30-minute payment cooldown or a
+// permanent park.
+var antigravityValidationMarkers = [...]string{
+	"validation_required",
+	"verify your account",
+	"validation_url",
+	"account verification required",
+}
+
+func isTOSViolationResultError(err *Error) bool {
+	if err == nil {
+		return false
+	}
+	status := statusCodeFromResult(err)
+	if status != http.StatusForbidden && status != http.StatusUnauthorized {
+		return false
+	}
+	return isTOSViolationMessage(err.Message) || isTOSViolationMessage(err.Code)
+}
+
+func isTOSViolationMessage(message string) bool {
+	lower := strings.ToLower(strings.TrimSpace(message))
+	if lower == "" {
+		return false
+	}
+	for _, marker := range antigravityTOSViolationMarkers {
+		if strings.Contains(lower, marker) {
+			return true
+		}
+	}
+	return false
+}
+
+// isValidationBlockedResultError reports the re-verification challenge. It is
+// checked after the TOS marker because a TOS block may mention verification too.
+func isValidationBlockedResultError(err *Error) bool {
+	if err == nil || isTOSViolationResultError(err) {
+		return false
+	}
+	if status := statusCodeFromResult(err); status != http.StatusForbidden {
+		return false
+	}
+	return isValidationBlockedMessage(err.Message) || isValidationBlockedMessage(err.Code)
+}
+
+func isValidationBlockedMessage(message string) bool {
+	lower := strings.ToLower(strings.TrimSpace(message))
+	if lower == "" {
+		return false
+	}
+	for _, marker := range antigravityValidationMarkers {
+		if strings.Contains(lower, marker) {
+			return true
+		}
+	}
+	return false
+}

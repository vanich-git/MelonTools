+// retries stay distinguishable. The raw session id is never sent upstream: it is
+// hashed first, which keeps the upstream value opaque while preserving
+// per-conversation stability.
+func generateRequestID(sessionID string, step int64) string {
+	conversation := antigravityConversationSegment(sessionID)
+	return fmt.Sprintf("agent/jetski/%s/%d", conversation, step)

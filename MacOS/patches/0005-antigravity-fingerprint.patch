@@ -0,0 +1,50 @@
+package executor
+
+import (
+	"regexp"
+	"strings"
+	"testing"
+)
+
+// officialRequestIDPattern mirrors the template the bundled language server
+// contains: "agent/jetski/%s/%d". Anything else is a fingerprint tell.
+var officialRequestIDPattern = regexp.MustCompile(`^agent/jetski/[0-9a-f]{16}/[0-9]+$`)
+
+func TestGenerateRequestIDMatchesOfficialShape(t *testing.T) {
+	id := generateRequestID("session-abc", 7)
+	if !officialRequestIDPattern.MatchString(id) {
+		t.Fatalf("requestId = %q, want agent/jetski/<16 hex>/<step>", id)
+	}
+	if !strings.HasSuffix(id, "/7") {
+		t.Fatalf("requestId = %q, want step 7 preserved", id)
+	}
+}
+
+// One conversation must keep one conversation segment, or the upstream sees a
+// new conversation on every turn.
+func TestGenerateRequestIDKeepsConversationSegmentStable(t *testing.T) {
+	first := generateRequestID("session-abc", 1)
+	second := generateRequestID("session-abc", 2)
+	if strings.Split(first, "/")[2] != strings.Split(second, "/")[2] {
+		t.Fatalf("conversation segment changed between turns: %q vs %q", first, second)
+	}
+	if first == second {
+		t.Fatalf("requestId repeats across steps: %q", first)
+	}
+}
+
+// The gateway's internal session id must not travel upstream verbatim.
+func TestGenerateRequestIDDoesNotLeakSessionID(t *testing.T) {
+	const sessionID = "sess-deadbeefcafe1234"
+	if id := generateRequestID(sessionID, 1); strings.Contains(id, sessionID) {
+		t.Fatalf("requestId %q leaks the raw session id", id)
+	}
+}
+
+func TestGenerateRequestIDSeparatesSessions(t *testing.T) {
+	main := generateRequestID("sess-main", 1)
+	sub := generateRequestID("sess-sub", 1)
+	if strings.Split(main, "/")[2] == strings.Split(sub, "/")[2] {
+		t.Fatalf("distinct sessions share a conversation segment: %q vs %q", main, sub)
+	}
+}

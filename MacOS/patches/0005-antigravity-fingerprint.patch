diff --git a/sdk/cliproxy/auth/conductor_tos_park_test.go b/sdk/cliproxy/auth/conductor_tos_park_test.go
new file mode 100644
index 0000000..4444dd0
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_tos_park_test.go
@@ -0,0 +1,204 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"sync"
+	"testing"
+	"time"
+)
+
+// tosViolationError mirrors the 403 Google returns for an account it has blocked
+// for a Terms of Service violation.
+func tosViolationError() *Error {
+	return &Error{
+		Code:       "permission_denied",
+		Message:    "This service has been disabled in this account for violation of Terms of Service. Please submit an appeal to continue using this product.",
+		HTTPStatus: http.StatusForbidden,
+	}
+}
+
+// TestApplyAuthFailureStateParksTOSViolationAsDisabled verifies that a TOS block
+// is persisted as disabled instead of a cooldown. A cooldown would expire and
+// route the next request back into the same permanent 403.
+func TestApplyAuthFailureStateParksTOSViolationAsDisabled(t *testing.T) {
+	now := time.Now()
+	auth := &Auth{ID: "tos-parked", Metadata: map[string]any{}}
+
+	applyAuthFailureState(auth, tosViolationError(), nil, now, false)
+
+	if !auth.Disabled {
+		t.Fatal("expected a TOS violation to disable the credential")
+	}
+	if auth.Status != StatusDisabled {
+		t.Fatalf("expected status %q, got %q", StatusDisabled, auth.Status)
+	}
+	if !auth.Unavailable {
+		t.Fatal("expected a TOS violation to mark the credential unavailable")
+	}
+	if auth.StatusMessage != tosViolationStatusMessage {
+		t.Fatalf("expected status message %q, got %q", tosViolationStatusMessage, auth.StatusMessage)
+	}
+	// A re-arm would make the scheduler retry a permanently dead credential.
+	if !auth.NextRetryAfter.IsZero() {
+		t.Fatalf("expected no retry schedule, got %v", auth.NextRetryAfter)
+	}
+	if auth.Quota.Exceeded {
+		t.Fatal("a TOS block is not a quota condition")
+	}
+	// The disabled flag must reach Metadata so the filestore writes it to disk;
+	// a memory-only park would be cleared by the next restart.
+	if disabled, ok := auth.Metadata["disabled"].(bool); !ok || !disabled {
+		t.Fatalf("expected metadata disabled=true, got %v", auth.Metadata["disabled"])
+	}
+	if reason, _ := auth.Metadata["disabled_reason"].(string); reason != tosViolationStatusMessage {
+		t.Fatalf("expected disabled_reason %q, got %q", tosViolationStatusMessage, reason)
+	}
+}
+
+// TestApplyAuthFailureStateKeepsPlainForbiddenCooling guards the neighbouring
+// behaviour: an ordinary 403 is still a cooldown and must not disable the
+// credential.
+func TestApplyAuthFailureStateKeepsPlainForbiddenCooling(t *testing.T) {
+	now := time.Now()
+	auth := &Auth{ID: "plain-forbidden", Metadata: map[string]any{}}
+	plainForbidden := &Error{Code: "forbidden", Message: "permission denied", HTTPStatus: http.StatusForbidden}
+
+	applyAuthFailureState(auth, plainForbidden, nil, now, false)
+
+	if auth.Disabled {
+		t.Fatal("a plain 403 must not disable the credential")
+	}
+	if auth.StatusMessage != "payment_required" {
+		t.Fatalf("expected the existing payment_required mapping, got %q", auth.StatusMessage)
+	}
+	if !auth.NextRetryAfter.After(now) {
+		t.Fatalf("expected a cooldown window, got %v", auth.NextRetryAfter)
+	}
+}
+
+// TestIsTOSViolationResultErrorMarkers covers the appeal wording Google ships in
+// the details array, which is what the live 403 carries.
+func TestIsTOSViolationResultErrorMarkers(t *testing.T) {
+	cases := []struct {
+		name string
+		err  *Error
+		want bool
+	}{
+		{"live message", tosViolationError(), true},
+		{"reason code", &Error{Code: "TOS_VIOLATION", Message: "blocked", HTTPStatus: http.StatusForbidden}, true},
+		{"plain forbidden", &Error{Code: "forbidden", Message: "permission denied", HTTPStatus: http.StatusForbidden}, false},
+		{"tos on success status", &Error{Code: "TOS_VIOLATION", HTTPStatus: http.StatusOK}, false},
+		{"nil", nil, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isTOSViolationResultError(tc.err); got != tc.want {
+				t.Fatalf("isTOSViolationResultError = %v, want %v", got, tc.want)
+			}
+		})
+	}
+}
+
+// recordingStore captures the payload handed to the store so a test can assert
+// that a state change actually reached persistence.
+type recordingStore struct {
+	mu    sync.Mutex
+	saves []*Auth
+}
+
+func (s *recordingStore) List(context.Context) ([]*Auth, error) { return nil, nil }
+
+func (s *recordingStore) Save(_ context.Context, auth *Auth) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.saves = append(s.saves, auth.Clone())
+	return auth.ID, nil
+}
+
+func (s *recordingStore) Delete(context.Context, string) error { return nil }
+
+func (s *recordingStore) last() *Auth {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if len(s.saves) == 0 {
+		return nil
+	}
+	return s.saves[len(s.saves)-1]
+}
+
+// TestMarkResultTOSViolationPersistsDisabled proves the park survives a restart.
+// The in-memory flag is not enough: the gateway persists through Store.Save and
+// only Metadata["disabled"] is read back on load. MarkResult reaches this branch
+// with a non-empty model, which is why the TOS check must run before the
+// per-model cooldown branch; if it regresses, a banned account silently returns
+// to the pool after a restart and burns a request on a permanent 403.
+func TestMarkResultTOSViolationPersistsDisabled(t *testing.T) {
+	store := &recordingStore{}
+	manager := NewManager(store, nil, nil)
+
+	auth := &Auth{
+		ID:       "antigravity-banned@example.com",
+		Provider: "antigravity",
+		Status:   StatusActive,
+		Metadata: map[string]any{"email": "banned@example.com"},
+	}
+	if _, err := manager.Register(context.Background(), auth); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+
+	manager.MarkResult(context.Background(), Result{
+		AuthID:   auth.ID,
+		Provider: "antigravity",
+		Model:    "gemini-3.8-flash-high",
+		Error:    tosViolationError(),
+	})
+
+	saved := store.last()
+	if saved == nil {
+		t.Fatal("MarkResult never persisted the credential")
+	}
+	if !saved.Disabled {
+		t.Fatal("persisted credential is not disabled: a restart would return the banned account to the pool")
+	}
+	if got := saved.Metadata["disabled"]; got != true {
+		t.Fatalf("persisted metadata[disabled] = %#v, want true (the loader reads this key)", got)
+	}
+	if got := saved.Metadata["disabled_reason"]; got != tosViolationStatusMessage {
+		t.Fatalf("persisted metadata[disabled_reason] = %#v, want %q", got, tosViolationStatusMessage)
+	}
+	if !saved.NextRetryAfter.IsZero() {
+		t.Fatalf("persisted NextRetryAfter = %v, want zero: a cooldown expires and retries a permanent block", saved.NextRetryAfter)
+	}
+}
+
+// TestMarkResultPlainForbiddenKeepsCooling guards the neighbouring behaviour: an
+// ordinary 403 is a per-model permission problem, not an account block, so the
+// credential must stay enabled.
+func TestMarkResultPlainForbiddenKeepsCooling(t *testing.T) {
+	store := &recordingStore{}
+	manager := NewManager(store, nil, nil)
+
+	auth := &Auth{ID: "antigravity-plain@example.com", Provider: "antigravity", Status: StatusActive, Metadata: map[string]any{}}
+	if _, err := manager.Register(context.Background(), auth); err != nil {
+		t.Fatalf("register: %v", err)
+	}
+
+	manager.MarkResult(context.Background(), Result{
+		AuthID:   auth.ID,
+		Provider: "antigravity",
+		Model:    "gemini-3.8-flash-high",
+		Error:    &Error{Code: "permission_denied", Message: "caller does not have permission", HTTPStatus: http.StatusForbidden},
+	})
+
+	saved := store.last()
+	if saved == nil {
+		t.Fatal("MarkResult never persisted the credential")
+	}
+	if saved.Disabled {
+		t.Fatal("a plain 403 must not disable the credential")
+	}
+	if got := saved.Metadata["disabled"]; got == true {
+		t.Fatal("a plain 403 wrote metadata[disabled]")
+	}
+}

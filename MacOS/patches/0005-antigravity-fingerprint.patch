+// AntigravityEgressVersion reports the pinned fingerprint version together with
+// the latest version the Hub manifest advertised, so callers and tests can see
+// when the calibration has gone stale without letting the manifest drive egress.
+func AntigravityEgressVersion() (pinned, latest string) {
+	antigravityVersionMu.RLock()
+	cached := cachedAntigravityVersion
+	antigravityVersionMu.RUnlock()
+
+	if cached == "" {
+		cached = antigravityFallbackVersion
+	}
+	if errFetch := antigravityLastFetchError(); errFetch != nil {
+		cached = ""
+	}
+	return antigravityCalibratedVersion, cached
+}
+
+// antigravityLastFetchError reports why the manifest read failed, if it did.
+func antigravityLastFetchError() error {
+	antigravityVersionMu.RLock()
+	defer antigravityVersionMu.RUnlock()
+	return antigravityVersionErr
+}

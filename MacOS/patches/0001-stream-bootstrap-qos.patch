+// ResetBootstrapCooldown releases the first-token watchdog cooldown for one
+// auth/model pair after the desktop health probe observed a fast response.
+func (h *Handler) ResetBootstrapCooldown(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "core auth manager unavailable"})
+		return
+	}
+
+	var req struct {
+		AuthIndex string `json:"auth_index"`
+		Model     string `json:"model"`
+	}
+	if errBindJSON := c.ShouldBindJSON(&req); errBindJSON != nil {
+		c.JSON(clienterror.HTTPStatusFromErrorOr(errBindJSON, http.StatusBadRequest), gin.H{"error": "invalid request body"})
+		return
+	}
+	authIndex := strings.TrimSpace(req.AuthIndex)
+	model := strings.TrimSpace(req.Model)
+	if authIndex == "" || model == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "auth_index and model are required"})
+		return
+	}
+	auth := h.authByIndex(authIndex)
+	if auth == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "auth not found"})
+		return
+	}
+	updated, cleared, errReset := h.authManager.ClearBootstrapCooldown(c.Request.Context(), auth.ID, model)
+	if errReset != nil {
+		c.JSON(http.StatusInternalServerError, gin.H{"error": fmt.Sprintf("failed to clear bootstrap cooldown: %v", errReset)})
+		return
+	}
+	if updated == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "auth not found"})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"status": "ok", "cleared": cleared, "auth_index": authIndex, "model": model})
+}

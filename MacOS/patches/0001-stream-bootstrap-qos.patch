new file mode 100644
index 00000000..9b91975c
--- /dev/null
+++ b/sdk/cliproxy/auth/stream_bootstrap_watchdog.go
@@ -0,0 +1,144 @@
+package auth
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// errStreamBootstrapTimeout is the sentinel returned by readStreamBootstrap when
+// the upstream produced no first payload before the watchdog fired. The caller
+// wraps it with the selected auth and model so the normal credential failover
+// path can record a cooldown and retry another account.
+var errStreamBootstrapTimeout = errors.New("stream bootstrap timeout")
+
+var streamBootstrapTimeoutNanos atomic.Int64
+
+// SetStreamBootstrapTimeout configures the first-payload watchdog. Zero
+// disables it. Negative values are treated as disabled.
+func SetStreamBootstrapTimeout(seconds int) {
+	if seconds <= 0 {
+		streamBootstrapTimeoutNanos.Store(0)
+		return
+	}
+	streamBootstrapTimeoutNanos.Store(int64(seconds) * int64(time.Second))
+}
+
+func streamBootstrapTimeout() time.Duration {
+	return time.Duration(streamBootstrapTimeoutNanos.Load())
+}
+
+const bootstrapStrikeTTL = 6 * time.Hour
+
+// bootstrapCooldownLadder is deliberately short for the first strike and long
+// for repeated silent throttling, mirroring the quarantine ladder used by the
+// desktop UI.
+var bootstrapCooldownLadder = [...]time.Duration{
+	60 * time.Second,
+	5 * time.Minute,
+	30 * time.Minute,
+	2 * time.Hour,
+}
+
+type bootstrapStrikeState struct {
+	strikes int
+	last    time.Time
+}
+
+var (
+	bootstrapStrikeMu sync.Mutex
+	bootstrapStrikes  = map[string]*bootstrapStrikeState{}
+)
+
+func bootstrapStrikeKey(authID, model string) string {
+	return authID + "\x00" + model
+}
+
+// nextBootstrapCooldown increments the silent-throttle strike count for an
+// auth/model pair and returns the cooldown for this strike. Strikes expire
+// after bootstrapStrikeTTL without another timeout.
+func nextBootstrapCooldown(authID, model string, now time.Time) time.Duration {
+	if authID == "" {
+		return bootstrapCooldownLadder[0]
+	}
+	key := bootstrapStrikeKey(authID, model)
+	bootstrapStrikeMu.Lock()
+	defer bootstrapStrikeMu.Unlock()
+	state := bootstrapStrikes[key]
+	if state == nil || now.Sub(state.last) > bootstrapStrikeTTL {
+		state = &bootstrapStrikeState{}
+		bootstrapStrikes[key] = state
+	}
+	state.strikes++
+	state.last = now
+	index := state.strikes - 1
+	if index >= len(bootstrapCooldownLadder) {
+		index = len(bootstrapCooldownLadder) - 1
+	}
+	return bootstrapCooldownLadder[index]
+}
+
+func resetBootstrapStrikes(authID, model string) {
+	if authID == "" {
+		return
+	}
+	key := bootstrapStrikeKey(authID, model)
+	bootstrapStrikeMu.Lock()
+	delete(bootstrapStrikes, key)
+	bootstrapStrikeMu.Unlock()
+}
+
+func bootstrapStrikeCount(authID, model string) int {
+	key := bootstrapStrikeKey(authID, model)
+	bootstrapStrikeMu.Lock()
+	defer bootstrapStrikeMu.Unlock()
+	if state := bootstrapStrikes[key]; state != nil {
+		return state.strikes
+	}
+	return 0
+}
+
+// streamBootstrapTimeoutError carries the per-strike cooldown through the
+// existing RetryAfter plumbing. A 504 keeps it on the retryable credential
+// path, so the conductor tries another auth instead of surfacing the failure.
+type streamBootstrapTimeoutError struct {
+	authID   string
+	model    string
+	waited   time.Duration
+	cooldown time.Duration
+}
+
+func newStreamBootstrapTimeoutError(authID, model string, waited, cooldown time.Duration) error {
+	return &streamBootstrapTimeoutError{
+		authID:   authID,
+		model:    model,
+		waited:   waited,
+		cooldown: cooldown,
+	}
+}
+
+func (e *streamBootstrapTimeoutError) Error() string {
+	if e == nil {
+		return errStreamBootstrapTimeout.Error()
+	}
+	return fmt.Sprintf("upstream produced no first token for %s (model %s); cooling down %s", e.authID, e.model, e.cooldown)
+}
+
+func (e *streamBootstrapTimeoutError) Unwrap() error {
+	return errStreamBootstrapTimeout
+}
+
+func (e *streamBootstrapTimeoutError) StatusCode() int {
+	return http.StatusGatewayTimeout
+}
+
+func (e *streamBootstrapTimeoutError) RetryAfter() *time.Duration {
+	if e == nil {
+		return nil
+	}
+	value := e.cooldown
+	return &value
+}

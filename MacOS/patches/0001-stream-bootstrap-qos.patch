+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"testing"
+	"time"
+
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func TestReadStreamBootstrapTimeout(t *testing.T) {
+	SetStreamBootstrapTimeout(1)
+	t.Cleanup(func() { SetStreamBootstrapTimeout(0) })
+	// Use a shorter interval than the config setter's second granularity by
+	// overriding the atomic value directly for the test.
+	streamBootstrapTimeoutNanos.Store(int64(20 * time.Millisecond))
+
+	ch := make(chan cliproxyexecutor.StreamChunk)
+	started := time.Now()
+	_, _, err := readStreamBootstrapForAuth(context.Background(), ch, "auth-a", "model-a", "antigravity", started)
+	if !errors.Is(err, errStreamBootstrapTimeout) {
+		t.Fatalf("err = %v, want timeout sentinel", err)
+	}
+	var timeoutErr *streamBootstrapTimeoutError
+	if !errors.As(err, &timeoutErr) {
+		t.Fatalf("err type = %T, want *streamBootstrapTimeoutError", err)
+	}
+	if timeoutErr.StatusCode() != http.StatusGatewayTimeout {
+		t.Fatalf("status = %d, want 504", timeoutErr.StatusCode())
+	}
+	if timeoutErr.RetryAfter() == nil || *timeoutErr.RetryAfter() != 60*time.Second {
+		t.Fatalf("retry after = %v, want 60s", timeoutErr.RetryAfter())
+	}
+	if got := bootstrapStrikeCount("auth-a", "model-a"); got != 1 {
+		t.Fatalf("strike count = %d, want 1", got)
+	}
+}
+
+func TestReadStreamBootstrapTimeoutDespiteHeartbeats(t *testing.T) {
+	SetStreamBootstrapTimeout(1)
+	t.Cleanup(func() { SetStreamBootstrapTimeout(0) })
+	streamBootstrapTimeoutNanos.Store(int64(25 * time.Millisecond))
+
+	ch := make(chan cliproxyexecutor.StreamChunk, 64)
+	done := make(chan struct{})
+	go func() {
+		for {
+			select {
+			case ch <- cliproxyexecutor.StreamChunk{Payload: nil}:
+			case <-done:
+				return
+			}
+		}
+	}()
+	t.Cleanup(func() { close(done) })
+	_, _, err := readStreamBootstrapForAuth(context.Background(), ch, "auth-hb", "model-hb", "antigravity", time.Now())
+	if !errors.Is(err, errStreamBootstrapTimeout) {
+		t.Fatalf("err = %v, want timeout despite continuous heartbeat chunks", err)
+	}
+}
+
+func TestReadStreamBootstrapNonAntigravityIsNotBounded(t *testing.T) {
+	SetStreamBootstrapTimeout(1)
+	t.Cleanup(func() { SetStreamBootstrapTimeout(0) })
+	streamBootstrapTimeoutNanos.Store(int64(25 * time.Millisecond))
+
+	ch := make(chan cliproxyexecutor.StreamChunk, 1)
+	go func() {
+		time.Sleep(80 * time.Millisecond)
+		ch <- cliproxyexecutor.StreamChunk{Payload: []byte("ok")}
+	}()
+	buffered, closed, err := readStreamBootstrap(context.Background(), ch, "codex")
+	if err != nil || closed || len(buffered) != 1 {
+		t.Fatalf("non-Antigravity bootstrap = %d chunks, closed=%v, err=%v; want the delayed payload", len(buffered), closed, err)
+	}
+}
+
+func TestReadStreamBootstrapFirstPayloadResetsStrikes(t *testing.T) {
+	SetStreamBootstrapTimeout(1)
+	t.Cleanup(func() { SetStreamBootstrapTimeout(0) })
+	nextBootstrapCooldown("auth-b", "model-b", time.Now())
+	nextBootstrapCooldown("auth-b", "model-b", time.Now())
+	if got := bootstrapStrikeCount("auth-b", "model-b"); got != 2 {
+		t.Fatalf("strike count before success = %d, want 2", got)
+	}
+
+	ch := make(chan cliproxyexecutor.StreamChunk, 1)
+	ch <- cliproxyexecutor.StreamChunk{Payload: []byte("data")}
+	close(ch)
+	buffered, closed, err := readStreamBootstrapForAuth(context.Background(), ch, "auth-b", "model-b", "antigravity", time.Now())
+	if err != nil || closed || len(buffered) != 1 {
+		t.Fatalf("buffered=%d closed=%v err=%v", len(buffered), closed, err)
+	}
+	if got := bootstrapStrikeCount("auth-b", "model-b"); got != 0 {
+		t.Fatalf("strike count after success = %d, want 0", got)
+	}
+}
+
+func TestBootstrapCooldownLadder(t *testing.T) {
+	resetBootstrapStrikes("auth-c", "model-c")
+	now := time.Now()
+	want := []time.Duration{60 * time.Second, 5 * time.Minute, 30 * time.Minute, 2 * time.Hour, 2 * time.Hour}
+	for index, expected := range want {
+		if got := nextBootstrapCooldown("auth-c", "model-c", now); got != expected {
+			t.Fatalf("strike %d cooldown = %v, want %v", index+1, got, expected)
+		}
+	}
+	// The TTL expires the strike chain.
+	got := nextBootstrapCooldown("auth-c", "model-c", now.Add(bootstrapStrikeTTL+time.Minute))
+	if got != 60*time.Second {
+		t.Fatalf("expired cooldown = %v, want 60s", got)
+	}
+}

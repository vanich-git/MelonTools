 // ResetQuota clears quota/cooldown state for an auth and resumes registry routing.
+// ClearBootstrapCooldown releases only the first-token watchdog cooldown for
+// one auth/model pair. The desktop health probe calls it after a successful
+// lightweight request so a recovered account returns to the pool before the
+// quarantine rung expires. Other quota and error cooldowns are untouched.
+func (m *Manager) ClearBootstrapCooldown(ctx context.Context, authID, model string) (*Auth, bool, error) {
+	if m == nil {
+		return nil, false, nil
+	}
+	authID = strings.TrimSpace(authID)
+	model = canonicalModelKey(strings.TrimSpace(model))
+	if authID == "" || model == "" {
+		return nil, false, fmt.Errorf("auth id and model are required")
+	}
+
+	now := time.Now()
+	releaseMutation := m.lockAuthMutation(authID)
+	defer releaseMutation()
+	m.mu.Lock()
+	auth, ok := m.auths[authID]
+	if !ok || auth == nil {
+		m.mu.Unlock()
+		return nil, false, nil
+	}
+	state := auth.ModelStates[model]
+	if state == nil {
+		m.mu.Unlock()
+		return auth, false, nil
+	}
+	// Only the watchdog layer is released here. A quota/credential cooldown must
+	// survive a successful lightweight probe.
+	if state.LastError == nil || state.LastError.StatusCode() != http.StatusGatewayTimeout ||
+		!strings.Contains(strings.ToLower(state.LastError.Message), "first token") {
+		m.mu.Unlock()
+		return auth, false, nil
+	}
+	state.Status = StatusActive
+	state.StatusMessage = ""
+	state.Unavailable = false
+	state.NextRetryAfter = time.Time{}
+	state.LastError = nil
+	state.UpdatedAt = now
+	updateAggregatedAvailability(auth, now)
+	auth.Generation++
+	auth.UpdatedAt = now
+	m.mu.Unlock()
+
+	if m.cooldownStore != nil {
+		m.persistCooldownStates(ctx)
+	}
+	resetBootstrapStrikes(authID, model)
+	return auth, true, nil
+}

+	cfg := &internalconfig.Config{GeminiKey: []internalconfig.GeminiKey{{
+		APIKey: apiKey,
+		Models: []internalconfig.GeminiModel{
+			{Name: first, Alias: alias},
+			{Name: second, Alias: alias},
+		},
+	}}}
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)

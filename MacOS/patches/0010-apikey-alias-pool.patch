+		identifier: provider,
+		executeFn: func(_ context.Context, _ *Auth, req cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+			attempts = append(attempts, req.Model)
+			if req.Model == first {
+				return cliproxyexecutor.Response{}, &Error{HTTPStatus: http.StatusInternalServerError, Message: "first model failed"}
+			}
+			return cliproxyexecutor.Response{Payload: []byte(req.Model)}, nil
+		},

+func TestAPIKeyClaudeAliasPoolAllCooledReturnsError(t *testing.T) {
+	const (
+		apiKey   = "sk-ant-all-cooled"
+		alias    = "claude-all-cooled"
+		first    = "claude-cooled-a"
+		second   = "claude-cooled-b"
+		provider = "claude"
+	)
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.SetConfig(claudeModelPoolConfig(apiKey, alias, first, second))
+	registerAPIKeyPoolAuth(t, manager, "claude-all-cooled-auth", provider, alias, map[string]string{
+		AttributeAPIKey: apiKey,
+		AttributeSource: "config:claude[all-cooled]",
+	})
+
+	attempts := 0
+	manager.RegisterExecutor(&mockCustomErrorExecutor{
+		identifier: provider,
+		executeFn: func(_ context.Context, _ *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+			attempts++
+			return cliproxyexecutor.Response{}, &Error{HTTPStatus: http.StatusTooManyRequests, Message: "all pooled models rate limited"}
+		},
+	})
+
+	for request := 1; request <= 3; request++ {
+		_, errExecute := manager.Execute(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: alias}, cliproxyexecutor.Options{})
+		if errExecute == nil {
+			t.Fatalf("request %d unexpectedly succeeded", request)
+		}
+	}
+	// Once every pooled model is cooling down, selection fails before it reaches
+	// an executor. The alias must not spin through upstream attempts forever.
+	if attempts != 2 {
+		t.Fatalf("upstream attempts = %d, want exactly two (one per pooled model)", attempts)
+	}
+	auth, okAuth := manager.GetByID("claude-all-cooled-auth")
+	if !okAuth || auth == nil {
+		t.Fatal("pool auth disappeared")
+	}
+	// The alias projection must not stay healthy once every pooled upstream
+	// model is cooling down.
+	if projection := manager.clientModelProjectionForAuth(auth, alias, time.Now()); !projection.Suspended {
+		t.Fatalf("all-pool cooldown must suspend alias projection: %+v", projection)
+	}
+	if projection := manager.clientModelProjectionForAuth(auth, alias, time.Now()); !projection.QuotaExceeded {
+		t.Fatalf("all-pool 429 must be reported as quota exhaustion: %+v", projection)
+	}
+	// Deterministic recovery: clearing the per-upstream cooldowns restores the
+	// alias projection without sleeping on wall-clock timers.
+	for _, model := range []string{first, second} {
+		if state := auth.ModelStates[model]; state != nil {
+			state.Unavailable = false
+			state.NextRetryAfter = time.Time{}
+			state.Quota.Exceeded = false
+			state.Quota.NextRecoverAt = time.Time{}
+		}
+	}
+	if projection := manager.clientModelProjectionForAuth(auth, alias, time.Now()); projection.Suspended {
+		t.Fatalf("alias projection must recover after pooled cooldowns expire: %+v", projection)
+	}
+}

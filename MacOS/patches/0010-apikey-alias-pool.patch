+func TestMixedProviderAliasRoutesAcrossProtocols(t *testing.T) {
+	const (
+		alias     = "mixed-pool-alias"
+		claudeKey = "sk-ant-mixed"
+		compatKey = "sk-compat-mixed"
+	)
+	claudeProvider := "claude"
+	compatProvider := util.OpenAICompatibleProviderKey("mixed")
+	registry.GetGlobalRegistry().RegisterClient("mixed-claude-client", claudeProvider, []*registry.ModelInfo{{ID: alias}})
+	registry.GetGlobalRegistry().RegisterClient("mixed-compat-client", compatProvider, []*registry.ModelInfo{{ID: alias}})
+	t.Cleanup(func() {
+		registry.GetGlobalRegistry().UnregisterClient("mixed-claude-client")
+		registry.GetGlobalRegistry().UnregisterClient("mixed-compat-client")
+	})
+
+	providers := util.GetProviderName(alias)
+	if len(providers) < 2 {
+		t.Fatalf("providers for %s = %v, want both protocols", alias, providers)
+	}
+	seen := map[string]bool{}
+	for _, provider := range providers {
+		seen[provider] = true
+	}
+	if !seen[claudeProvider] || !seen[compatProvider] {
+		t.Fatalf("providers for %s = %v, want claude and openai-compatibility", alias, providers)
+	}
+
+	cfg := claudeModelPoolConfig(claudeKey, alias, "claude-sonnet-4-5")
+	cfg.OpenAICompatibility = []internalconfig.OpenAICompatibility{{
+		Name:          "mixed",
+		BaseURL:       "https://mixed.example.test/v1",
+		APIKeyEntries: []internalconfig.OpenAICompatibilityAPIKey{{APIKey: compatKey}},
+		Models:        []internalconfig.OpenAICompatibilityModel{{Name: "mixed-compat-model", Alias: alias}},
+	}}
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.SetConfig(cfg)
+	registerAPIKeyPoolAuth(t, manager, "mixed-claude-auth", claudeProvider, alias, map[string]string{
+		AttributeAPIKey: claudeKey,
+		AttributeSource: "config:claude[mixed]",
+	})
+	registerAPIKeyPoolAuth(t, manager, "mixed-compat-auth", compatProvider, alias, map[string]string{
+		AttributeAPIKey: compatKey,
+		"compat_name":   "mixed",
+		AttributeSource: "config:openai-compatibility[mixed]",
+	})
+
+	var attemptedProviders []string
+	manager.RegisterExecutor(&mockCustomErrorExecutor{
+		identifier: claudeProvider,
+		executeFn: func(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+			attemptedProviders = append(attemptedProviders, auth.Provider)
+			return cliproxyexecutor.Response{}, &Error{HTTPStatus: http.StatusBadGateway, Message: "claude upstream failed"}
+		},
+	})
+	manager.RegisterExecutor(&mockCustomErrorExecutor{
+		identifier: compatProvider,
+		executeFn: func(_ context.Context, auth *Auth, _ cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+			attemptedProviders = append(attemptedProviders, auth.Provider)
+			return cliproxyexecutor.Response{Payload: []byte("compat-ok")}, nil
+		},
+	})
+
+	orderedProviders := []string{claudeProvider, compatProvider}
+	response, errExecute := manager.Execute(context.Background(), orderedProviders, cliproxyexecutor.Request{Model: alias}, cliproxyexecutor.Options{})
+	if errExecute != nil {
+		t.Fatalf("mixed provider request: %v", errExecute)
+	}
+	if string(response.Payload) != "compat-ok" {
+		t.Fatalf("response = %s, want compat-ok", response.Payload)
+	}
+	if len(attemptedProviders) != 2 {
+		t.Fatalf("attempted providers = %v, want both protocols", attemptedProviders)
+	}
+}

+func registerAPIKeyPoolAuth(t *testing.T, manager *Manager, id, provider, model string, attributes map[string]string) *Auth {
+	t.Helper()
+	registry.GetGlobalRegistry().RegisterClient(id, provider, []*registry.ModelInfo{{ID: model}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+	auth := &Auth{
+		ID:         id,
+		Provider:   provider,
+		Status:     StatusActive,
+		Attributes: attributes,
+	}
+	if _, errRegister := manager.Register(context.Background(), auth); errRegister != nil {
+		t.Fatalf("register auth %s: %v", id, errRegister)
+	}
+	return auth
+}
+
+func claudeModelPoolConfig(apiKey, alias string, names ...string) *internalconfig.Config {
+	models := make([]internalconfig.ClaudeModel, 0, len(names))
+	for _, name := range names {
+		models = append(models, internalconfig.ClaudeModel{Name: name, Alias: alias})
+	}
+	return &internalconfig.Config{ClaudeKey: []internalconfig.ClaudeKey{{APIKey: apiKey, Models: models}}}
+}
+
+func TestAPIKeyClaudeAliasPoolRotatesAndFallsBackAcrossModels(t *testing.T) {
+	const (
+		apiKey   = "sk-ant-pool"
+		alias    = "claude-pool"
+		first    = "claude-sonnet-4-5"
+		second   = "claude-opus-4-1"
+		provider = "claude"
+	)
+	manager := NewManager(nil, &RoundRobinSelector{}, nil)
+	manager.SetConfig(claudeModelPoolConfig(apiKey, alias, first, second))
+	registerAPIKeyPoolAuth(t, manager, "claude-pool-auth", provider, alias, map[string]string{
+		AttributeAPIKey: apiKey,
+		AttributeSource: "config:claude[pool]",
+	})
+
+	var attempts []string
+	manager.RegisterExecutor(&mockCustomErrorExecutor{
+		identifier: provider,
+		executeFn: func(_ context.Context, _ *Auth, req cliproxyexecutor.Request, _ cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+			attempts = append(attempts, req.Model)
+			if req.Model == first {
+				return cliproxyexecutor.Response{}, &Error{HTTPStatus: http.StatusTooManyRequests, Message: "first model rate limited"}
+			}
+			return cliproxyexecutor.Response{Payload: []byte(req.Model)}, nil
+		},
+	})
+
+	response, errExecute := manager.Execute(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: alias}, cliproxyexecutor.Options{})
+	if errExecute != nil {
+		t.Fatalf("first request: %v", errExecute)
+	}
+	if string(response.Payload) != second {
+		t.Fatalf("first response = %s, want fallback model %s", response.Payload, second)
+	}
+	// The rotation offset advances on every request, so the follow-up starts
+	// with the model that survived the 429 instead of walking into it again.
+	response, errExecute = manager.Execute(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: alias}, cliproxyexecutor.Options{})
+	if errExecute != nil {
+		t.Fatalf("follow-up request after 429: %v", errExecute)
+	}
+	if string(response.Payload) != second {
+		t.Fatalf("follow-up response = %s, want %s", response.Payload, second)
+	}
+	response, errExecute = manager.Execute(context.Background(), []string{provider}, cliproxyexecutor.Request{Model: alias}, cliproxyexecutor.Options{})
+	if errExecute != nil {
+		t.Fatalf("third request after 429: %v", errExecute)
+	}
+	if string(response.Payload) != second {
+		t.Fatalf("third response = %s, want %s", response.Payload, second)
+	}
+	wantAttempts := []string{first, second, second, second}
+	if strings.Join(attempts, ",") != strings.Join(wantAttempts, ",") {
+		t.Fatalf("attempts = %v, want %v", attempts, wantAttempts)
+	}
+	// A 429 on one pooled model must cool only that model, not the whole alias.
+	auth, okAuth := manager.GetByID("claude-pool-auth")
+	if !okAuth || auth == nil {
+		t.Fatal("pool auth disappeared")
+	}
+	if auth.ModelStates[first] == nil || !auth.ModelStates[first].Unavailable {
+		t.Fatalf("rate-limited model %s must be cooled: %+v", first, auth.ModelStates[first])
+	}
+	if auth.ModelStates[second] != nil && auth.ModelStates[second].Unavailable {
+		t.Fatalf("healthy pooled model %s must stay available: %+v", second, auth.ModelStates[second])
+	}
+}

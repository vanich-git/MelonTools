diff --git a/internal/clienterror/client_error.go b/internal/clienterror/client_error.go
index 124518e4..e72e33d6
--- a/internal/clienterror/client_error.go
+++ b/internal/clienterror/client_error.go
@@ -11,6 +11,46 @@ import (
 	"github.com/tidwall/gjson"
 )
 
+// upstreamBody returns the upstream response body carried by err, without the
+// wrapper text that an intermediate error type may prepend.
+//
+// The engine wraps an upstream refusal in auth.Error, whose Error() renders as
+// "code: <body>". Reading err.Error() verbatim there makes every JSON body check
+// below fail, so classification silently degrades to the status switch at the
+// end of IsRequestFault: a 400 that says "the model is unavailable on this
+// credential" then reads as a caller mistake, the group stops rotating, and the
+// client gets the first provider's error even though a later member would have
+// served the request.
+func upstreamBody(err error) string {
+	if err == nil {
+		return ""
+	}
+	type responseBodyProvider interface {
+		ResponseBody() []byte
+	}
+	var responseBody responseBodyProvider
+	if errors.As(err, &responseBody) && responseBody != nil {
+		if body := strings.TrimSpace(string(responseBody.ResponseBody())); body != "" {
+			return body
+		}
+	}
+	raw := strings.TrimSpace(err.Error())
+	if raw == "" || json.Valid([]byte(raw)) {
+		return raw
+	}
+	// Recover a JSON body hidden behind a wrapper prefix such as "invalid_request: ".
+	for offset, char := range raw {
+		if char != '{' && char != '[' {
+			continue
+		}
+		candidate := strings.TrimSpace(raw[offset:])
+		if json.Valid([]byte(candidate)) {
+			return candidate
+		}
+	}
+	return raw
+}
+
 // StatusClientClosedRequest is the nginx-style status used when the client
 // aborts the request before the proxy finishes (context.Canceled).
 const StatusClientClosedRequest = 499
@@ -106,6 +146,18 @@ func IsRequestFault(status int, err error) bool {
 	if hasModelNotFoundErrorBody(err) {
 		return false
 	}
+	// A provider that answers "this model is unavailable" or "the API is not
+	// open for your rank" with 400 is describing the credential, not the
+	// request. Rotating to another provider is exactly what the caller needs,
+	// and a model group exists precisely so one dead upstream does not fail
+	// the whole request.
+	if status == http.StatusBadRequest || status == http.StatusUnauthorized ||
+		status == http.StatusForbidden || status == http.StatusUnprocessableEntity ||
+		status == http.StatusNotFound {
+		if hasCredentialUnavailableBody(err) {
+			return false
+		}
+	}
 	if hasRequestFaultBody(err) {
 		return true
 	}
@@ -145,7 +197,7 @@ func IsClaudeThreadNotFound(status int, err error) bool {
 	if status != http.StatusNotFound || err == nil {
 		return false
 	}
-	body := strings.TrimSpace(err.Error())
+	body := upstreamBody(err)
 	type responseBodyProvider interface {
 		ResponseBody() []byte
 	}
@@ -169,7 +221,7 @@ func hasModelNotFoundErrorBody(err error) bool {
 	if err == nil {

 }
+
+// prefixedBodyError mimics auth.Error, whose Error() renders as "code: <body>".
+// The body is what carries the provider's verdict, so classification must read
+// through the prefix instead of treating the whole string as the payload.
+type prefixedBodyError struct {
+	status int
+	code   string
+	body   string
+}
+
+func (e prefixedBodyError) Error() string   { return e.code + ": " + e.body }
+func (e prefixedBodyError) StatusCode() int { return e.status }
+
+func TestIsRequestFaultReadsThroughWrapperPrefix(t *testing.T) {
+	const unavailable = `{"error":{"code":"invalid_request","message":"Модель deepseek-v4.1-flash сейчас недоступна. Открой список моделей и выбери другую.","type":"invalid_request_error"}}`
+	tests := []struct {
+		name string
+		err  error
+		want bool
+	}{
+		{
+			name: "model gate behind a prefix keeps the failover alive",
+			err:  prefixedBodyError{status: http.StatusBadRequest, code: "invalid_request", body: unavailable},
+			want: false,
+		},
+		{
+			name: "same body without a prefix",
+			err:  statusError{status: http.StatusBadRequest, body: unavailable},
+			want: false,
+		},
+		{
+			name: "a real caller mistake is still a request fault",
+			err:  prefixedBodyError{status: http.StatusBadRequest, code: "invalid_request", body: `{"error":{"message":"temperature must be <= 2"}}`},
+			want: true,
+		},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := IsRequestFault(http.StatusBadRequest, tc.err); got != tc.want {
+				t.Fatalf("IsRequestFault(400, %v) = %t, want %t", tc.err, got, tc.want)
+			}
+		})
+	}
+}

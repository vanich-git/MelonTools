 func hasRequestFaultBody(err error) bool {
 	if err == nil {
 		return false
 	}
-	body := strings.TrimSpace(err.Error())
+	body := upstreamBody(err)
 	if body == "" || !json.Valid([]byte(body)) {
 		return false
 	}

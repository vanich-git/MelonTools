@@ -198,11 +250,79 @@ func hasAuthenticationErrorBody(err error) bool {
 	return false
 }
 
+// hasCredentialUnavailableBody reports upstream bodies that blame the selected
+// credential for the model being unusable: a plan gate, a closed API tier, or
+// a model the provider currently cannot serve. They travel as 400 with a
+// generic invalid_request_error body, so the status alone says "request fault"
+// and the engine would drop the failover the caller is paying for.
+func hasCredentialUnavailableBody(err error) bool {
+	if err == nil {
+		return false
+	}
+	body := upstreamBody(err)
+	if body == "" || !json.Valid([]byte(body)) {
+		return false
+	}
+	for _, path := range []string{"error.code", "code", "response.error.code", "body.error.code"} {
+		code := strings.ToLower(strings.TrimSpace(gjson.Get(body, path).String()))
+		switch code {
+		case "ide_only", "model_not_available", "model_unavailable", "model_not_supported":
+			return true
+		}
+	}
+	for _, path := range []string{"error.message", "message", "response.error.message", "body.error.message"} {
+		message := strings.ToLower(strings.TrimSpace(gjson.Get(body, path).String()))
+		if message == "" {
+			continue
+		}
+		for _, pattern := range credentialUnavailablePatterns {
+			if strings.Contains(message, pattern) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// credentialUnavailablePatterns covers the English and Russian wording the
+// providers in the catalog actually return for a credential-scoped model gate.
+var credentialUnavailablePatterns = []string{
+	"not available for your plan",
+	"not available for your account",
+	"not available in your",
+	"temporarily unavailable",
+	"currently unavailable",
+	"model is unavailable",
+	"model unavailable",
+	// Russian providers phrase the same gate without repeating "model":
+	// "Модель X сейчас недоступна", "прямой API временно закрыт".
+	" недоступн",
+	" недоступен",
+	" недоступна",
+	"апи закрыт",
+	"api закрыт",
+	"временно закрыт",
+	// A rejected or exhausted key is also a credential fault. Several relays
+	// label it invalid_request_error, which would otherwise read as a caller
+	// mistake and stop the rotation the group is supposed to perform.
+	"invalid api key",
+	"incorrect api key",
+	"api key not valid",
+	"invalid_api_key",
+	"ключ не принят",
+	"ключ недействителен",
+	"неверный ключ",
+	"ключ отключ",
+	"исчерпана его личная квота",
+	"quota exceeded",
+	"insufficient_quota",
+}

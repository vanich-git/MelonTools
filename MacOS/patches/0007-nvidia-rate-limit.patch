+package helps
+
+import (
+	"crypto/sha256"
+	"net/http"
+	"strings"
+	"sync"
+	"time"
+)
+
+// The rolling window is shared by every NVIDIA model using the same API key.
+var nvidiaRequests = struct {
+	sync.Mutex
+	times map[[32]byte][]time.Time
+}{times: make(map[[32]byte][]time.Time)}
+
+func NvidiaLimitedDo(client *http.Client, req *http.Request) (*http.Response, error) {
+	if !strings.EqualFold(req.URL.Hostname(), "integrate.api.nvidia.com") || req.Method != http.MethodPost {
+		return client.Do(req)
+	}
+	key := sha256.Sum256([]byte(req.Header.Get("Authorization")))
+	for {
+		nvidiaRequests.Lock()
+		now := time.Now()
+		// Drop expired keys as well as old timestamps, without retaining credentials.
+		for k, times := range nvidiaRequests.times {
+			i := 0
+			for i < len(times) && !times[i].After(now.Add(-time.Minute)) {
+				i++
+			}
+			if i == len(times) {
+				delete(nvidiaRequests.times, k)
+			} else {
+				nvidiaRequests.times[k] = times[i:]
+			}
+		}
+		times := nvidiaRequests.times[key]
+		if len(times) < 40 {
+			nvidiaRequests.times[key] = append(times, now)
+			nvidiaRequests.Unlock()
+			return client.Do(req)
+		}
+		wait := time.Until(times[0].Add(time.Minute))
+		nvidiaRequests.Unlock()
+		timer := time.NewTimer(wait)
+		select {
+		case <-req.Context().Done():
+			if !timer.Stop() {
+				select {
+				case <-timer.C:
+				default:
+				}
+			}
+			return nil, req.Context().Err()
+		case <-timer.C:
+		}
+	}
+}

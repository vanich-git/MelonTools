+package helps
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type nvidiaTestTransport struct{}
+
+func (nvidiaTestTransport) RoundTrip(*http.Request) (*http.Response, error) {
+	return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("ok")), Header: make(http.Header)}, nil
+}
+
+func TestNvidiaRateLimitSharedAndCancelable(t *testing.T) {
+	nvidiaRequests.Lock()
+	nvidiaRequests.times = make(map[[32]byte][]time.Time)
+	nvidiaRequests.Unlock()
+	client := &http.Client{Transport: nvidiaTestTransport{}}
+	request := func(key string, ctx context.Context) *http.Request {
+		req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://integrate.api.nvidia.com/v1/chat/completions", nil)
+		req.Header.Set("Authorization", key)
+		return req
+	}
+	for i := 0; i < 40; i++ {
+		resp, err := NvidiaLimitedDo(client, request("key-a", context.Background()))
+		if err != nil {
+			t.Fatal(err)
+		}
+		resp.Body.Close()
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := NvidiaLimitedDo(client, request("key-a", ctx)); err != context.Canceled {
+		t.Fatalf("expected cancellation, got %v", err)
+	}
+	resp, err := NvidiaLimitedDo(client, request("key-b", context.Background()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	nvidiaRequests.Lock()
+	for key, times := range nvidiaRequests.times {
+		for i := range times {
+			times[i] = time.Now().Add(-time.Minute)
+		}
+		nvidiaRequests.times[key] = times
+	}
+	nvidiaRequests.Unlock()
+	resp, err = NvidiaLimitedDo(client, request("key-a", context.Background()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+}
+
+func TestNvidiaRateLimitConcurrentRequests(t *testing.T) {
+	nvidiaRequests.Lock()
+	nvidiaRequests.times = make(map[[32]byte][]time.Time)
+	nvidiaRequests.Unlock()
+	client := &http.Client{Transport: nvidiaTestTransport{}}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	var completed atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 64; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			req, _ := http.NewRequestWithContext(ctx, http.MethodPost, "https://integrate.api.nvidia.com/v1/chat/completions", nil)
+			req.Header.Set("Authorization", "same-key")
+			resp, err := NvidiaLimitedDo(client, req)
+			if err == nil {
+				resp.Body.Close()
+				if completed.Add(1) == 40 {
+					cancel()
+				}
+			}
+		}()
+	}
+	wg.Wait()
+	if got := completed.Load(); got != 40 {
+		t.Fatalf("got %d requests, want 40", got)
+	}
+}

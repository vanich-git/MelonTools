+
+// GetReloadStatusV8 reports how far the asynchronous reload has got.
+//
+// PUT /v8/management/config.yaml answers before reloadConfigAfterManagementSave
+// runs, and no other management read exposes that completion: the config GETs
+// return the file or the value assigned to h.cfg before the 200, while
+// /v1/models carries aliases but not the provider generation behind them. A
+// client that must know whether its file was handed to the runtime compares
+// the generation it received with applied-generation here.
+func (h *Handler) GetReloadStatusV8(c *gin.Context) {
+	if h == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "not_found"})
+		return
+	}
+	h.mu.Lock()
+	saved := h.reloadGeneration
+	applied := h.appliedReloadGeneration
+	savedDigest := h.savedConfigDigest
+	appliedDigest := h.appliedConfigDigest
+	h.mu.Unlock()
+	c.Header("Cache-Control", "no-store")
+	// Generations also advance for plugin reloads, which save no YAML. The
+	// digest pair is the config-save contract: pending means the last saved
+	// document has not been proven applied, even if a later unrelated reload
+	// already advanced the generation counter.
+	c.JSON(http.StatusOK, gin.H{
+		"saved-generation":   saved,
+		"applied-generation": applied,
+		"saved-digest":       savedDigest,
+		"applied-digest":     appliedDigest,
+		"pending":            savedDigest != "" && savedDigest != appliedDigest,
+	})
 }
 

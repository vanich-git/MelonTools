diff --git a/internal/api/handlers/management/config_v8_reload_status_test.go b/internal/api/handlers/management/config_v8_reload_status_test.go
new file mode 100644
index 0000000..48b6720
--- /dev/null
+++ b/internal/api/handlers/management/config_v8_reload_status_test.go
@@ -0,0 +1,221 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+const reloadStatusConfig = `config-version: 8
+server:
+  host: "127.0.0.1"
+  port: 8317
+access:
+  api-keys:
+    - "client"
+management:
+  allow-remote: false
+`
+
+type reloadStatusAnswer struct {
+	Saved         uint64 `json:"saved-generation"`
+	Applied       uint64 `json:"applied-generation"`
+	SavedDigest   string `json:"saved-digest"`
+	AppliedDigest string `json:"applied-digest"`
+	Pending       bool   `json:"pending"`
+}
+
+type reloadPutAnswer struct {
+	Status           string `json:"status"`
+	ConfigVersion    int    `json:"config-version"`
+	ReloadGeneration uint64 `json:"reload-generation"`
+	ReloadDigest     string `json:"reload-digest"`
+}
+
+func newReloadStatusHandler(t *testing.T, hook func(context.Context, *config.Config) bool) (*Handler, *gin.Engine) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, []byte(reloadStatusConfig), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.LoadConfig(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &Handler{cfg: cfg, configFilePath: path}
+	if hook != nil {
+		h.SetConfigReloadResultHook(hook)
+	}
+	router := gin.New()
+	router.PUT("/v8/management/config.yaml", h.ConfigV8)
+	router.GET("/v8/management/reload-status", h.GetReloadStatusV8)
+	return h, router
+}
+
+func putReloadStatusConfig(t *testing.T, router *gin.Engine, body string) reloadPutAnswer {
+	t.Helper()
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodPut, "/v8/management/config.yaml", strings.NewReader(body)))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("PUT status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+	var answer reloadPutAnswer
+	if err := json.Unmarshal(recorder.Body.Bytes(), &answer); err != nil {
+		t.Fatalf("PUT answer is not JSON: %v (%s)", err, recorder.Body.String())
+	}
+	if answer.Status != "ok" || answer.ConfigVersion != 8 {
+		t.Fatalf("PUT lost its v8 acknowledgement: %+v", answer)
+	}
+	if answer.ReloadGeneration == 0 {
+		t.Fatal("PUT did not report a reload generation")
+	}
+	if answer.ReloadDigest == "" {
+		t.Fatal("PUT did not report the digest of the saved config")
+	}
+	return answer
+}
+
+func readReloadStatus(t *testing.T, router *gin.Engine) reloadStatusAnswer {
+	t.Helper()
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/v8/management/reload-status", nil))
+	if recorder.Code != http.StatusOK {
+		t.Fatalf("GET reload-status=%d body=%s", recorder.Code, recorder.Body.String())
+	}
+	var answer reloadStatusAnswer
+	if err := json.Unmarshal(recorder.Body.Bytes(), &answer); err != nil {
+		t.Fatalf("reload-status is not JSON: %v", err)
+	}
+	return answer
+}
+
+func waitAppliedDigest(t *testing.T, router *gin.Engine, digest string) reloadStatusAnswer {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		status := readReloadStatus(t, router)
+		if status.AppliedDigest == digest {
+			return status
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("digest %s was never applied: %+v", digest, status)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func TestConfigV8ReloadStatusReportsAsyncCompletion(t *testing.T) {
+	release := make(chan struct{}, 4)
+	_, router := newReloadStatusHandler(t, func(_ context.Context, _ *config.Config) bool {
+		<-release
+		return true
+	})
+
+	put := putReloadStatusConfig(t, router, strings.Replace(reloadStatusConfig, "port: 8317", "port: 8318", 1))
+	status := readReloadStatus(t, router)
+	if status.Saved != put.ReloadGeneration || status.SavedDigest != put.ReloadDigest || !status.Pending {
+		t.Fatalf("accepted save was reported as applied: %+v (generation=%d digest=%s)", status, put.ReloadGeneration, put.ReloadDigest)
+	}
+
+	release <- struct{}{}
+	status = waitAppliedDigest(t, router, put.ReloadDigest)
+	if status.Pending || status.Applied != put.ReloadGeneration {
+		t.Fatalf("completed reload is still pending or lost its generation: %+v", status)
+	}
+}
+
+func TestConfigV8ReloadStatusAppliesOnlyTheLatestConcurrentSave(t *testing.T) {
+	release := make(chan struct{}, 4)
+	_, router := newReloadStatusHandler(t, func(_ context.Context, _ *config.Config) bool {
+		<-release
+		return true
+	})
+
+	first := putReloadStatusConfig(t, router, strings.Replace(reloadStatusConfig, "port: 8317", "port: 8318", 1))
+	second := putReloadStatusConfig(t, router, strings.Replace(reloadStatusConfig, "port: 8317", "port: 8319", 1))
+	if first.ReloadDigest == second.ReloadDigest {
+		t.Fatal("different documents produced the same digest")
+	}
+	release <- struct{}{}
+	release <- struct{}{}
+
+	status := waitAppliedDigest(t, router, second.ReloadDigest)
+	if status.Pending || status.SavedDigest != second.ReloadDigest || status.AppliedDigest != second.ReloadDigest {
+		t.Fatalf("an older save won over the latest one: %+v", status)
+	}
+}
+
+func TestConfigV8ReloadStatusAcceptsIdenticalDigest(t *testing.T) {
+	_, router := newReloadStatusHandler(t, func(_ context.Context, _ *config.Config) bool { return true })
+
+	body := strings.Replace(reloadStatusConfig, "port: 8317", "port: 8318", 1)
+	first := putReloadStatusConfig(t, router, body)
+	waitAppliedDigest(t, router, first.ReloadDigest)
+
+	second := putReloadStatusConfig(t, router, body)
+	if second.ReloadDigest != first.ReloadDigest {
+		t.Fatalf("identical documents produced different digests: %s != %s", second.ReloadDigest, first.ReloadDigest)
+	}
+	status := readReloadStatus(t, router)
+	if status.Pending || status.AppliedDigest != second.ReloadDigest {
+		t.Fatalf("an already applied identical document stayed pending: %+v", status)
+	}
+}
+
+func TestConfigV8ReloadStatusDoesNotPublishFailedApply(t *testing.T) {
+	_, router := newReloadStatusHandler(t, func(_ context.Context, _ *config.Config) bool { return false })
+
+	put := putReloadStatusConfig(t, router, strings.Replace(reloadStatusConfig, "port: 8317", "port: 8318", 1))
+	// The callback is invoked asynchronously; give it a chance to report failure.
+	time.Sleep(100 * time.Millisecond)
+	status := readReloadStatus(t, router)
+	if status.SavedDigest != put.ReloadDigest || status.AppliedDigest != "" || !status.Pending {
+		t.Fatalf("a rejected apply was published as applied: %+v", status)
+	}
+}
+
+func TestConfigV8ReloadStatusDoesNotClaimAnUnappliedSave(t *testing.T) {
+	_, router := newReloadStatusHandler(t, nil)
+
+	put := putReloadStatusConfig(t, router, strings.Replace(reloadStatusConfig, "port: 8317", "port: 8320", 1))
+	status := readReloadStatus(t, router)
+	if status.SavedDigest != put.ReloadDigest || status.AppliedDigest != "" || !status.Pending {
+		t.Fatalf("a save without a consumer was reported as applied: %+v", status)
+	}
+}
+
+func TestConfigV8ReloadDigestMatchesAppliedDocument(t *testing.T) {
+	ports := make(chan int, 4)
+	h, router := newReloadStatusHandler(t, func(_ context.Context, cfg *config.Config) bool {
+		ports <- cfg.Port
+		return true
+	})
+
+	put := putReloadStatusConfig(t, router, strings.Replace(reloadStatusConfig, "port: 8317", "port: 8318", 1))
+	saved, err := os.ReadFile(h.configFilePath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := config.ComputeSourceHash(saved); got != put.ReloadDigest {
+		t.Fatalf("digest does not describe the saved document: reported=%s file=%s", put.ReloadDigest, got)
+	}
+	waitAppliedDigest(t, router, put.ReloadDigest)
+	select {
+	case port := <-ports:
+		if port != 8318 {
+			t.Fatalf("hook received a different document than the one saved: port=%d", port)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("hook was never called with the saved document")
+	}
+}

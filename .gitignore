# macOS metadata (exFAT AppleDouble sidecars)
.DS_Store
._*

# Build artifacts
build/
derived/
*.dmg
*.exe
*.sha256
Windows/dist/

# Xcode user state
xcuserdata/
*.xcuserdata/

# Third-party sources (fetch with scripts/fetch-sources.sh)
_sources/

# Pinned llama.cpp engine: fetched by MacOS/scripts/fetch-runtime.sh at build
# time (universal binary, ~140 MB). Never commit platform binaries.
MacOS/app/Resources/runtime/

# Local agent notes may contain machine-specific paths
MacOS/AGENTS.md
MacOS/specs/

# Signing material and local secrets must never enter git
*.p12
*.pfx
*.cer
*.key
*.mobileprovision
.env
.env.*
!.env.example

# Local image generation output
imagegen-output/
Melon_Amber_*/
Melon_Amber_macOS*.png
Melon_Amber_macOS*.icns

# Locally built release artifacts (uploaded to GitHub Releases, never committed)
/delivery/

# Local scratch state from development runs (never committed)
/AGENTS.md
/.cargo-home-windows/
/.cargo-target-windows/
/.openrouter-xcode/
/local-build-*/
/MacOS/app/.derivedData/
/MacOS/app/.testResults/
/MacOS/app/.tmp/
/Windows/.build-apfs.sparseimage
/Windows/app/src-tauri/.cargo/
/Windows/app/src-tauri/.cargo-target-windows/
/Windows/app/src-tauri/check.exit
/Windows/app/src-tauri/check.log

# Vendored Tauri crate snapshots used by local patch experiments
/Windows/patches/

# Normalize line endings and keep generated or binary files out of diffs.
* text=auto eol=lf

*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.swift text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.plist text eol=lf
*.nsi text eol=lf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.icns binary
*.ico binary
*.dmg binary
*.exe binary
*.z binary
*.zip binary

# exFAT AppleDouble files are metadata, never source.
._* export-ignore
.DS_Store export-ignore

docs/** linguist-documentation
specs/** linguist-documentation

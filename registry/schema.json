{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vanich-git/MelonTools/main/registry/schema.json",
  "title": "Melon Plugins registry",
  "type": "object",
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "1 for GitHub release installs, 2 when a plugin uses direct artifact URLs."
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "description", "author"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "description": "Stable plugin id. Must match the name of the built dynamic library."
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "version": {
          "type": "string",
          "pattern": "^[0-9][0-9A-Za-z.+-]*$",
          "description": "Optional display fallback. The GitHub release tag is authoritative."
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "Required for github-release installs."
        },
        "logo": { "type": "string", "format": "uri-reference" },
        "homepage": { "type": "string", "format": "uri-reference" },
        "license": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "auth_required": { "type": "boolean" },
        "install": { "$ref": "#/$defs/install" },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version"],
            "properties": {
              "version": { "type": "string" },
              "install": { "$ref": "#/$defs/install" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["github-release", "direct"] },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["goos", "goarch", "url", "sha256"],
            "properties": {
              "goos": { "type": "string", "enum": ["darwin", "windows", "linux", "freebsd"] },
              "goarch": { "type": "string", "enum": ["arm64", "amd64"] },
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
              "size": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
